{
  "argument_loc": "Local",
  "description": "Lock vehicle (disable mounting / dismounting) for player.\nThis command will remove user get in/get out actions but will not stop player getting into or out of vehicle via script commands (e.g [[moveInCargo]]).\n{{Feature|informative|Alternative syntax is similar to [[setVehicleLock]] but with numbers.}}",
  "effect_loc": "Global",
  "examples": [
    "<sqf>_jeepOne lock true;</sqf>",
    "<sqf>\nheli lock true;\nlocked heli; // 2\n\nheli lock false;\nlocked heli; // 0\n\nheli lock 1;\nlocked heli; // 1\n</sqf>"
  ],
  "groups": [
    "Object Manipulation"
  ],
  "id": "lock",
  "name": "lock",
  "problem_notes": [],
  "see_also": [
    "locked",
    "setVehicleLock",
    "lockDriver",
    "lockCargo",
    "lockTurret"
  ],
  "since": {
