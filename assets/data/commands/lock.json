    "arma2oa": "1.50",
    "arma3": "0.50",
    "ofp": "1.00",
    "ofpe": "1.00",
    "tkoh": "1.00"
  },
  "status": "Passed",
  "syntax": [
    {
      "call": {
        "Binary": [
          "vehicleName",
          "locked"
        ]
      },
      "left": {
        "Item": {
          "name": "vehicleName",
          "type": "Object"
        }
      },
      "ret": {
        "type": "Nothing"
      },
      "right": {
        "Item": {
          "desc": "[[true]] to lock, [[false]] to unlock",
          "name": "locked",
          "type": "Boolean"
        }
      }
    },
    {
      "call": {
        "Binary": [
          "vehicleName",
          "lockstate"
        ]
      },
      "left": {
        "Item": {
          "name": "vehicleName",
          "type": "Object"
        }
      },
