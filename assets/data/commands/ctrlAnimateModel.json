  "status": "Passed",
  "syntax": [
    {
      "call": {
        "Binary": [
          "control",
          [
            "source",
            "phase",
            "speed"
          ]
        ]
      },
      "left": {
        "Item": {
          "desc": "3D control",
          "name": "control",
          "type": "Control"
        }
      },
      "ret": {
        "type": "Nothing"
      },
      "right": {
        "Array": [
          {
            "Item": {
              "desc": "common source",
              "name": "source",
              "type": "String"
            }
          },
          {
            "Item": {
              "desc": "wanted animation phase",
              "name": "phase",
              "type": "Number"
            }
          },
          {
            "Item": {
              "desc": "(Optional, default [[false]])",
              "name": "speed",
              "type": {
                "OneOf": [
                  {
                    "desc": "[[Boolean]] - when set to [[true]], animation is instant\n{{GVI|arma3|1.66|size= 0.75}} [[Number]] - > 0 is treated as config speed value multiplier",
                    "since": null,
                    "type": "Boolean"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ]
