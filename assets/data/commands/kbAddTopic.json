  ],
  "since": {
    "arma2": "1.00",
    "arma2oa": "1.50",
    "arma3": "0.50",
    "tkoh": "1.00"
  },
  "status": "Passed",
  "syntax": [
    {
      "call": {
        "Binary": [
          "person",
          [
            "topicName",
            "conversationFile",
            "fsmFile",
            "eventHandler"
          ]
        ]
      },
      "left": {
        "Item": {
          "name": "person",
          "type": "Object"
        }
      },
      "ret": {
        "type": "Nothing"
      },
      "right": {
        "Array": [
          {
            "Item": {
              "desc": "the topic id for further reference",
              "name": "topicName",
              "type": "String"
            }
          },
          {
            "Item": {
              "desc": ".bikb file path",
              "name": "conversationFile",
              "type": "String"
            }
          },
          {
            "Item": {
              "desc": ".fsm file path. Receives the following parameters:\n* _sentenceId: the sentence as defined in the .bikb file\n* _topic: TopicName registered via kbAddTopic\n* _this: the person that was talked to (receiver)\n* _from: the person that talked to the receiver and triggered the script",
              "name": "fsmFile",
              "optional": true,
              "type": "String"
            }
          },
          {
            "Item": {
              "desc": "code to execute - given String will be [[compile]]d. This is not an sqf file path.<br>",
              "name": "eventHandler",
              "optional": true,
              "type": {
                "OneOf": [
                  {
                    "desc": null,
                    "since": null,
                    "type": "Code"
                  },
                  {
                    "desc": null,
                    "since": null,
                    "type": "String"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}