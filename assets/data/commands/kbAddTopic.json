{
  "argument_loc": "Local",
  "description": "Register conversation topic to given person. See [[Conversations]] for more details.\n{{Feature|informative|Only the speaker(s) need to have the topic added.}}",
  "effect_loc": "Local",
  "examples": [
    "<sqf>player kbAddTopic [\"myTest\", \"myTest.bikb\", \"myTest.fsm\", compile preprocessFileLineNumbers \"myTest.sqf\"];</sqf>",
    "<sqf>player kbAddTopic [\"itsGettingWarm\", \"weatherTalk.bikb\"];</sqf>"
  ],
  "groups": [
    "Conversations"
  ],
  "id": "kbAddTopic",
  "name": "kbAddTopic",
  "problem_notes": [],
