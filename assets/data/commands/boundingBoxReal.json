{
  "argument_loc": "Global",
  "description": "[[File:Boundingbox.jpg|right|200px]] Returns a raw bounding box of given object in model coordinates space. This command is similar to [[boundingBox]] but gives more precise measurements.<br>\nThe alternative syntax allows to specify clipping type to be used, which in some cases could make the result even more precise.",
  "effect_loc": "Unspecified",
  "examples": [
    "<sqf>\nprivate _bbr = boundingBoxReal vehicle player;\nprivate _p1 = _bbr select 0;\nprivate _p2 = _bbr select 1;\nprivate _maxWidth = abs ((_p2 select 0) - (_p1 select 0));\nprivate _maxLength = abs ((_p2 select 1) - (_p1 select 1));\nprivate _maxHeight = abs ((_p2 select 2) - (_p1 select 2));\n</sqf>",
    "<sqf>hint str (0 boundingBoxReal cursorObject);</sqf>"
  ],
  "groups": [
    "Object Manipulation"
  ],
  "id": "boundingBoxReal",
  "name": "boundingBoxReal",
  "problem_notes": [],
  "see_also": [
    "boundingBox",
    "sizeOf",
    "boundingCenter"
  ],
  "since": {
    "arma3": "0.50"
  },
  "status": "Passed",
  "syntax": [
    {
      "call": {
        "Unary": "object"
      },
      "ret": {
        "desc": "the extreme points of the model along {{GVI|arma3|1.92|size= 0.75}} the bounding box sphere radius, in format [[xmin, ymin, zmin], [xmax, ymax, zmax], boundingSphereRadius]",
        "type": "Position3dRelative"
      },
      "right": {
        "Item": {
          "name": "object",
          "type": "Object"
        }
      }
    },
    {
      "call": {
        "Binary": [
          "clippingType",
          "object"
        ]
      },
      "left": {
        "Item": {
          "desc": "can be one of",
          "name": "clippingType",
          "type": {
            "NumberEnum": [
              {
                "desc": "ClipVisual (can significantly reduce bounding box's size on buildings)",
                "since": null,
                "value": 0
              },
              {
                "desc": "ClipShadow",
                "since": null,
                "value": 1
              },
              {
                "desc": "ClipGeometry",
                "since": null,
                "value": 2
              },
              {
                "desc": "ClipGeneral (same type that is used in the main syntax)",
                "since": null,
                "value": 3
              }
            ]
          }
        }
      },
      "ret": {
        "desc": "the extreme points of the model, as well as bounding sphere radius, in format [[xmin, ymin, zmin], [xmax, ymax, zmax], boundingSphereRadius]",
        "type": "Position3dRelative"
      },
      "right": {
        "Item": {
          "name": "object",
          "type": "Object"
        }
      },
      "since": {
        "arma3": "1.92"
      }
    },
    {
      "call": {
        "Unary": [
          "object",
          "LOD"
        ]
      },
      "ret": {
        "desc": "the extreme points of the model, as well as bounding box sphere radius, in format [[xmin, ymin, zmin], [xmax, ymax, zmax], boundingSphereRadius]",
        "type": "Position3dRelative"
      },
      "right": {
        "Array": [
          {
            "Item": {
              "name": "object",
              "type": "Object"
            }
          },
          {
            "Item": {
              "desc": "",
              "name": "LOD",
              "type": {
                "StringEnum": [
                  {
                    "desc": null,
                    "since": null,
                    "value": "Memory"
                  },
                  {
                    "desc": null,
                    "since": null,
                    "value": "Geometry"
                  },
                  {
                    "desc": null,
                    "since": null,
                    "value": "FireGeometry"
                  },
                  {
                    "desc": null,
                    "since": null,
                    "value": "LandContact"
                  },
                  {
                    "desc": null,
                    "since": null,
                    "value": "HitPoints"
                  },
                  {
                    "desc": null,
                    "since": null,
                    "value": "ViewGeometry"
                  }
                ]
              }
            }
          }
        ]
      },
      "since": {
        "arma3": "2.14"
      }
    }
  ]
}