    "select",
    "isKindOf",
    "BIS_fnc_returnParents"
  ],
  "since": {
    "arma3": "1.48"
  },
  "status": "Passed",
  "syntax": [
    {
      "call": {
        "Unary": "config"
      },
      "ret": {
        "desc": "ordered from parent to child",
        "type": {
          "ArrayUnsized": {
            "value": "Config"
          }
        }
      },
      "right": {
        "Item": {
          "desc": "target config",
          "name": "config",
          "type": "Config"
        }
      }
    },
    {
      "call": {
        "Unary": [
          "config",
          "classesOnly",
          "includeBases",
          "reversedOrder",
          "configNames"
        ]
      },
      "ret": {
        "desc": "Strings represent config names",
        "type": {
          "ArrayUnsized": {
            "value": {
              "OneOf": [
                {
                  "desc": null,
                  "since": null,
                  "type": "Config"
                },
                {
                  "desc": null,
                  "since": null,
                  "type": "String"
                }
              ]
            }
          }
        }
      },
      "right": {
        "Array": [
          {
            "Item": {
              "desc": "target config",
              "name": "config",
              "type": "Config"
            }
          },
          {
            "Item": {
              "desc": "when [[true]], only classes are included in output and not properties",
              "name": "classesOnly",
              "type": "Boolean"
            }
          },
          {
            "Item": {
              "desc": "when [[true]], returned parents will include base classes (see description)",
              "name": "includeBases",
              "type": "Boolean"
            }
          },
          {
            "Item": {
              "desc": "when [[true]], the return order is from child to parent",
              "name": "reversedOrder",
              "type": "Boolean"
            }
          },
          {
            "Item": {
              "desc": "when [[true]], the return is [[Array]] of [[String]]s, when [[false]] - [[Array]] of [[Config]]s. Default: [[false]]",
              "name": "configNames",
              "optional": true,
              "type": "Boolean"
            }
          }
        ]
      },
      "since": {
        "arma3": "2.22"
      }
    }
  ]
}